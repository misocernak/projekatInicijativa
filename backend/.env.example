# Produkcioni šablon. Na serveru ide u /home/lepslnlp/lepsasrbija-api/.env (van public_html).
# Fajl .env se NE commit-uje i deploy ga nikad ne prepisuje.
# APP_KEY ostaje prazan: deploy ga sam generiše pri prvom pokretanju.
# Posle svake izmene .env pokrenite deploy ponovo (konfiguracija se kešira).
#
# Za lokalni razvoj prepravite DB_* na lokalnu bazu i APP_ENV=local, APP_DEBUG=true.

APP_NAME="Lepša Srbija"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lepsasrbija.com
APP_LOCALE=sr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=lepslnlp_IME_BAZE
DB_USERNAME=lepslnlp_IME_KORISNIKA
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=lepsasrbija.com
SANCTUM_STATEFUL_DOMAINS=lepsasrbija.com

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

MAIL_MAILER=smtp
MAIL_HOST=mail.lepsasrbija.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=no-reply@lepsasrbija.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@lepsasrbija.com
MAIL_FROM_NAME="Lepša Srbija"

# Prijava preko Google-a (opciono). Dok nisu popunjeni, dugme se ne prikazuje.
# Redirect URI mora tačno da bude upisan u Google Cloud (Credentials > OAuth client > Authorized redirect URIs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://lepsasrbija.com/api/auth/google/callback
